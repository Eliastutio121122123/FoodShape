# Use a restricted SQL Server login for the API, not the sa account.
# Set FOODSHARE_SQLSERVER_CONNECTION in your local .env file or shell.
FOODSHARE_SQLSERVER_CONNECTION=Server=host.docker.internal,1433;Database=FoodShareDb;User ID=foodshare_api;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;Connect Timeout=15
